# Настройки локальной лампы Xiaomi
LAMP_IP=192.168.0.2
LAMP_TOKEN=ваш_32_значный_токен_шифрования

# Настройки LLM (Google AI Studio / Gemini)
LLM_API_KEY=ваш_ключ_google_ai_studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

# Настройки голосового ассистента
ASSISTANT_NAME=ишак
VOICE_FEEDBACK=true
VOICE_LANGUAGE=ru-RU
VOICE_NAME=ru-RU-DmitryNeural
